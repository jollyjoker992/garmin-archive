# Copy to .env (same folder as garmin_archive.py) or export these in the environment.
# Real environment variables win over this file.

# Required. Create at https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# First day to back up. Default: 365 days before today.
# Set it to the day you started wearing the device to avoid crawling empty days.
GARMIN_START_DATE=2024-01-01

# Where days/, archives/, logs/ and manifest.json live. Default: ./data
#GARMIN_ARCHIVE_DIR=/Users/me/garmin-data

# Upload targets, in rclone "remote:path" form. Leave unset to skip a target.
#GARMIN_GDRIVE_REMOTE=gdrive:Backups/garmin
#GARMIN_S3_REMOTE=s3garmin:my-bucket/garmin
#GARMIN_S3_STORAGE_CLASS=GLACIER        # or DEEP_ARCHIVE, GLACIER_IR, STANDARD

# Politeness and retries (defaults shown).
#GARMIN_MIN_INTERVAL=1.0                # seconds between any two requests
#GARMIN_MAX_ATTEMPTS=5                  # tries per request
#GARMIN_BACKOFF_BASE=2                  # first retry delay, doubles each attempt
#GARMIN_BACKOFF_MAX=120                 # longest retry delay
#GARMIN_RATE_LIMIT_BACKOFF=30           # first wait after HTTP 429, doubles per attempt (max 600)
#GARMIN_RATE_LIMIT_COOLDOWN=300         # pause of the whole crawl when 429 persists, doubles (max 1800)
#GARMIN_RATE_LIMIT_COOLDOWNS=4          # pauses in a row before stopping until the next run
#GARMIN_TIMEOUT=30                      # seconds per request
#GARMIN_MAX_DAYS_PER_RUN=0              # 0 = no limit

# FHIR mapping (garmin_fhir.py).
#GARMIN_FHIR_PATIENT_NAME="Given Family"   # name on the FHIR Patient
#GARMIN_FHIR_BASE=https://github.com/jollyjoker992/garmin-archive/fhir  # never change after loading

# Docker scheduler (docker-compose.yml reads these from this file).
#GARMIN_SCHEDULE_TIME=06:15            # HH:MM, or several: 06:15,18:15
#GARMIN_TZ=UTC                         # IANA time zone of the schedule, e.g. Europe/Berlin
#GARMIN_RUN_ON_START=true              # run the pipeline when the container starts

# Other.
#GARMIN_SETTLE_DAYS=2                   # a day is final once it is this many days old
#GARMIN_INCLUDE_TODAY=false             # true: also fetch today (provisional) -> last night's sleep the same morning
#GARMIN_SKIP_ENDPOINTS=menstrual_cycle_summary,menstrual_cycle_day_view
#GARMIN_LOG_LEVEL=INFO
#GARMIN_RCLONE_BIN=rclone
