# Copy to docker/secrets.env (or create it with docker/create-s3-key.sh).
# Read by the container only; overrides the s3garmin rclone remote so it uses a
# static key instead of the host's AWS profile (which may need the macOS Keychain).
RCLONE_CONFIG_S3GARMIN_ENV_AUTH=false
RCLONE_CONFIG_S3GARMIN_PROFILE=
RCLONE_CONFIG_S3GARMIN_ACCESS_KEY_ID=
RCLONE_CONFIG_S3GARMIN_SECRET_ACCESS_KEY=
